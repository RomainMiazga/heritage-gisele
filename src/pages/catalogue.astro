---
import { getCollection } from 'astro:content';
import MainLayout from '../layouts/MainLayout.astro';

const toutesLesCreations = await getCollection('creations');
const title = "Nos Créations - L'Héritage de Gisèle";
---

<MainLayout title={title}>
  <div id="toast-container" class="global-toast-container"></div>

  <section class="catalogue-top container">
    <h1 class="page-title">Nos Créations</h1>
    <p>Chaque nœud est une intention, chaque perle un héritage.</p>
  </section>

<div class="grid-produits container">
    {toutesLesCreations.map((crea) => (
      <a href={`/creations/${crea.slug || crea.data?.slug || crea.id}/`} class="lien-carte-produit">
        <div class="card-produit">
          <div class="image-wrapper">
            <img src={`/images/${crea.data.image_url}`} alt={crea.data.nom} />
          </div>
          <h3>{crea.data.nom}</h3>
          <p class="produit-prix">{crea.data.prix} €</p>
          <p class="produit-description">{crea.data.description}</p>

          {crea.data.stock > 0 ? (
            <button 
              class="btn-ajouter js-add-to-cart" 
              data-id={crea.data.id} 
              data-nom={crea.data.nom}
              data-prix={crea.data.prix}
            >
              <i class="fas fa-shopping-basket"></i> En stock
            </button>
          ) : (
            <span class="btn-ajouter btn-disabled">Victime de son succès</span>
          )}
        </div>
      </a>
    ))}
  </div>
</MainLayout>

<script is:inline>
  document.addEventListener('astro:page-load', () => {
    const buttons = document.querySelectorAll('.js-add-to-cart');
    const toastContainer = document.getElementById('toast-container');

    const showToast = (nom) => {
      if (!toastContainer) return;
      toastContainer.innerHTML = ''; // Nettoie les anciens messages

      const toast = document.createElement('div');
      toast.className = 'confirmation-bar-fixed';
      toast.innerHTML = `
        <div class="conf-inner">
          <div class="conf-text">
            <i class="fas fa-check-circle"></i>
            <span><strong>${nom}</strong> ajouté au panier</span>
          </div>
          <a href="/devis/" class="conf-btn">VOIR MON PANIER</a>
        </div>
      `;
      
      toastContainer.appendChild(toast);

      setTimeout(() => {
        toast.style.transform = 'translateY(-100%)';
        toast.style.opacity = '0';
        setTimeout(() => toast.remove(), 600);
      }, 4000);
    };

    buttons.forEach(btn => {
      btn.onclick = (e) => {
        e.preventDefault();
        e.stopPropagation(); // Évite la redirection vers la page produit au clic sur le bouton
        const item = {
          id: btn.dataset.id, nom: btn.dataset.nom, prix: btn.dataset.prix
        };

        let panier = JSON.parse(localStorage.getItem('panier-gisele') || '[]');
        panier.push(item);
        localStorage.setItem('panier-gisele', JSON.stringify(panier));

        window.dispatchEvent(new Event('panierMisAJour'));
        showToast(item.nom);
      };
    });
  });
</script>

<style is:global>
  /* Supprime le style de lien sur les cartes */
  .lien-carte-produit {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .global-toast-container {
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    width: 100% !important;
    z-index: 999999 !important;
    pointer-events: none;
  }

  .confirmation-bar-fixed {
    pointer-events: auto;
    background: #7b4b94 !important;
    color: white !important;
    width: 100% !important;
    padding: 15px 0 !important;
    box-shadow: 0 4px 20px rgba(0,0,0,0.3) !important;
    transition: all 0.5s ease-in-out;
    display: block !important;
    border-bottom: 2px solid #D4AF37 !important;
  }

  .conf-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .conf-text {
    display: flex;
    align-items: center;
    gap: 15px;
    font-size: 1.1rem !important;
    font-family: serif;
  }

  .conf-text i {
    color: #D4AF37 !important;
    font-size: 1.5rem;
  }

  .conf-btn {
    background: transparent !important;
    color: white !important;
    border: 1px solid white !important;
    padding: 8px 18px !important;
    border-radius: 4px !important;
    text-decoration: none !important;
    font-weight: bold !important;
    font-size: 0.85rem !important;
    transition: 0.3s !important;
  }

  .conf-btn:hover {
    background: white !important;
    color: #5e35b1 !important;
  }

  .card-produit {
    background: white;
    padding: 20px;
    border-radius: 15px;
    border: 1px solid #eee;
    text-align: center;
    transition: transform 0.4s cubic-bezier(0.165, 0.84, 0.44, 1), 
                box-shadow 0.4s ease, 
                border-color 0.4s ease;
    cursor: pointer;
  }

  .card-produit:hover {
    transform: translateY(-10px);
    box-shadow: 0 15px 35px rgba(123, 75, 148, 0.15);
    border-color: #eaddf2;
  }

  .card-produit .image-wrapper {
    overflow: hidden;
    border-radius: 10px;
    margin-bottom: 15px;
  }

  .card-produit img { 
    width: 100%; 
    height: 350px; 
    object-fit: cover; 
    border-radius: 10px;
    transition: transform 0.6s ease;
  }

  .card-produit:hover img {
    transform: scale(1.1);
  }

  .card-produit h3 {
    margin: 15px 0 10px 0;
    transition: color 0.3s ease;
  }

  .card-produit:hover h3 {
    color: #7b4b94;
  }

  .btn-ajouter {
    position: relative;
    overflow: hidden;
    background: #7b4b94 !important;
    color: white !important;
    border: none !important;
    padding: 14px 28px !important;
    border-radius: 50px !important;
    cursor: pointer !important;
    font-weight: 600 !important;
    font-size: 0.95rem !important;
    display: inline-flex !important;
    align-items: center;
    justify-content: center;
    gap: 10px;
    text-decoration: none !important;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
    box-shadow: 0 4px 12px rgba(123, 75, 148, 0.2) !important;
  }

  .btn-ajouter:hover {
    background: #6a3d82 !important;
    transform: scale(1.05);
    box-shadow: 0 6px 20px rgba(123, 75, 148, 0.4) !important;
  }

  .btn-ajouter:hover i {
    transform: translateX(3px) rotate(-10deg);
  }

  .btn-ajouter i {
    transition: transform 0.3s ease;
    color: #D4AF37;
    font-size: 1.1rem;
  }

  .btn-disabled {
    background: #f0f0f0 !important;
    color: #999 !important;
    border: 1px solid #e0e0e0 !important;
    padding: 14px 28px !important;
    border-radius: 50px !important;
    cursor: not-allowed !important;
    display: inline-block !important;
    font-size: 0.9rem !important;
    font-style: italic;
  }

  @media (max-width: 768px) {
    .conf-inner {
      flex-direction: column;
      gap: 10px;
    }
  }

  .container { max-width: 1100px; margin: 0 auto; padding: 0 20px; }
  .catalogue-top { text-align: center; padding: 20px 0; }
  .page-title { font-size: 3em; color: #7b4b94; }
  .grid-produits {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 30px;
    padding-bottom: 80px;
  }
</style>