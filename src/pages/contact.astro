---
import BaseHead from '../components/BaseHead.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const title = "Contact - L'Héritage de Gisèle";
const description = "Une question ou une commande spéciale ? Contactez-moi, je vous répondrai avec plaisir.";
---

<!DOCTYPE html>
<html lang="fr">
	<head>
		<BaseHead title={title} description={description} />
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
	</head>
	<body>
		<Navbar />

		<main>
            <section class="contact-hero">
                <h1>Contactez-moi</h1>
                <p>Une question, une commande spéciale ou juste un mot doux ?</p>
            </section>

            <div class="contact-container">
                <aside class="contact-info">
                    <h2>Mes Coordonnées</h2>
                    <p class="intro-text">N'hésitez pas à me solliciter, je réponds généralement sous 24h à 48h.</p>
                    
                    <div class="info-item">
                        <i class="fas fa-envelope"></i>
                        <div>
                            <strong>Email</strong>
                            <p>lheritagedegisele@gmail.com</p>
                        </div>
                    </div>
                    
                    <div class="info-item">
                        <i class="fas fa-map-marker-alt"></i>
                        <div>
                            <strong>Atelier</strong>
                            <p>Envoi dans toute la France<br>Depuis mon petit atelier à Fameck</p>
                        </div>
                    </div>

                    <div class="info-item">
                        <i class="fab fa-instagram"></i>
                        <div>
                            <strong>Réseaux Sociaux</strong>
                            <p>@lheritagedegisele</p>
                        </div>
                    </div>
                </aside>

                <div class="contact-form-card">
                    <form action="/api/contact/" method="POST">
                        <div class="form-group">
                            <label for="nom">Nom Complet</label>
                            <input type="text" id="nom" name="nom" class="form-control" placeholder="Votre nom..." required>
                        </div>

                        <div class="form-group">
                            <label for="email">Adresse Email</label>
                            <input type="email" id="email" name="email" class="form-control" placeholder="votre@email.com" required>
                        </div>

                        <div class="form-group">
                            <label for="sujet">Sujet</label>
                            <select id="sujet" name="sujet" class="form-control">
                                <option value="Question sur un produit">Question sur un produit</option>
                                <option value="Suivi de commande">Suivi de commande</option>
                                <option value="Partenariat">Partenariat / Projets</option>
                                <option value="Autre">Autre</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label for="message">Votre Message</label>
                            <textarea id="message" name="message" class="form-control" rows="6" placeholder="Comment puis-je vous aider ?" required></textarea>
                        </div>

                        <button type="submit" class="btn-send">
                            <i class="fas fa-paper-plane"></i> Envoyer le message
                        </button>
                    </form>
                </div>
            </div>
        </main>

		<Footer />
	</body>
</html>

<style>
    /* Hero Section */
    .contact-hero { 
        background: #fbf9fc; 
        padding: 80px 20px 100px; 
        text-align: center; 
        border-bottom: 1px solid #eee; 
    }
    
    .contact-hero h1 {
        color: #7b4b94; 
        font-family: 'Great Vibes', cursive; 
        font-size: 3.5rem; 
        margin: 0;
    }

    .contact-hero p {
        font-style: italic; 
        color: #666;
        font-size: 1.2rem;
        margin-top: 10px;
    }

    /* Container */
    .contact-container { 
        max-width: 1100px; 
        margin: -50px auto 80px; 
        display: grid; 
        grid-template-columns: 1fr 1.5fr; 
        gap: 40px; 
        padding: 0 20px; 
    }
    
    /* Colonne Infos (Violette) */
    .contact-info { 
        background: #7b4b94; 
        color: white; 
        padding: 40px; 
        border-radius: 15px; 
        box-shadow: 0 10px 30px rgba(123, 75, 148, 0.2); 
    }

    .contact-info h2 { 
        color: #d4af37; 
        margin-top: 0; 
        font-family: 'Great Vibes', cursive;
        font-size: 2.2rem;
    }

    .intro-text { 
        margin-bottom: 30px; 
        opacity: 0.9; 
        line-height: 1.6;
    }

    .info-item { 
        display: flex; 
        align-items: flex-start; 
        margin-bottom: 25px; 
    }

    .info-item i { 
        font-size: 1.2rem; 
        margin-right: 15px; 
        margin-top: 5px; 
        color: #d4af37; 
    }

    .info-item p { 
        margin: 0; 
        line-height: 1.5; 
        opacity: 0.9;
    }

    /* Colonne Formulaire (Blanche) */
    .contact-form-card { 
        background: white; 
        padding: 50px; 
        border-radius: 15px; 
        box-shadow: 0 10px 40px rgba(0,0,0,0.06); 
        border: 1px solid #f0f0f0; 
    }

    .form-group { margin-bottom: 25px; }

    .form-group label { 
        display: block; 
        margin-bottom: 10px; 
        font-weight: 600; 
        color: #4a3b52; 
    }

    .form-control { 
        width: 100%; 
        padding: 14px; 
        border: 1px solid #e0e0e0; 
        border-radius: 10px; 
        font-family: inherit; 
        font-size: 1rem; 
        box-sizing: border-box; 
        transition: all 0.3s ease;
    }

    .form-control:focus { 
        border-color: #7b4b94; 
        outline: none; 
        box-shadow: 0 0 0 4px rgba(123, 75, 148, 0.1); 
        background: #fdfbff;
    }
    
    /* Bouton Envoyer */
    .btn-send { 
        background: #7b4b94; 
        color: white; 
        border: none; 
        padding: 18px 30px; 
        border-radius: 35px; 
        cursor: pointer; 
        font-size: 1.1rem; 
        font-weight: bold; 
        width: 100%; 
        transition: all 0.3s ease;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 10px;
    }

    .btn-send:hover { 
        background: #5e35b1; 
        transform: translateY(-3px); 
        box-shadow: 0 5px 15px rgba(94, 53, 177, 0.3);
    }

    /* Responsive */
    @media (max-width: 768px) {
        .contact-hero h1 { font-size: 2.8rem; }
        .contact-container { grid-template-columns: 1fr; margin-top: 20px; gap: 30px; }
        .contact-info { padding: 30px; }
        .contact-form-card { padding: 30px; }
    }
</style>