---
import MainLayout from '../../layouts/MainLayout.astro'; // Ajustez les ".." selon l'emplacement de votre fichier

const title = "Chapelet Livia - L'Héritage de Gisèle";
const description = "Découvrez le Chapelet Livia, une douce protection pour une nièce confectionné avec soin.";
---

<MainLayout title={title} description={description}>
  <div id="toast-container" class="global-toast-container"></div>

  <div class="container page-produit-single">
    <!-- Bouton Retour -->
    <a href="/catalogue/" class="btn-retour">
      <i class="fas fa-arrow-left"></i> Retour au catalogue
    </a>

    <div class="produit-grid">
      <!-- Colonne Gauche : Galerie photos -->
      <div class="galerie-photos">
        <div class="photo-principale">
          <img src="/images/chapelet-livia-1.webp" alt="Chapelet Livia - Vue d'ensemble" id="main-photo" />
        </div>
        <!-- Miniatures -->
        <div class="miniatures-grid">
          <img src="/images/chapelet-livia-1.webp" alt="Chapelet Livia - Vue d'ensemble" onclick="changeImage(this)" class="miniature active" />
          <img src="/images/chapelet-livia-4.webp" alt="Plan plus éloigné du chapelet" onclick="changeImage(this)" class="miniature" />
          <img src="/images/chapelet-livia-5.webp" alt="Plan légérement rapproché du chapelet Livia" onclick="changeImage(this)" class="miniature" />
          <img src="/images/chapelet-livia-2.webp" alt="Plan très rapproché du chapelet Livia" onclick="changeImage(this)" class="miniature" />
          <img src="/images/chapelet-livia-3.webp" alt="Photo d'ensemble des perles, médaillon et croix" onclick="changeImage(this)" class="miniature" />
        </div>
      </div>

      <!-- Colonne Droite : Informations, Perles & Achat -->
      <div class="produit-details">
        <h1 class="page-title">Chapelet Livia</h1>
        <p class="prix-single">20 €</p>
        
        <p class="description-chapeau">
          Un doux retour à soi. Conçu pour accompagner vos moments de prière et de recueillement avec une infinie délicatesse.
        </p>

        <!-- Section Caractéristiques & Type de perles -->
        <div class="caracteristiques-box">
          <h3><i class="fas fa-gem" style="color: #D4AF37;"></i> Caractéristiques & Matériaux</h3>
          <ul>
            <li><strong>Type de perles :</strong> Perles de verre, perles nacrées en acrylique</li>
            <li><strong>Diamètre des perles :</strong> 8 mm, 4 mm </li>
            <li><strong>Composants :</strong> Croix et inter-médaille en alliage en zinc résistant</li>
            <li><strong>Montage :</strong> Assemblé à la main sur un cordon ciré haute résistance</li>
          </ul>
        </div>

        <!-- Bouton d'ajout au panier -->
        <div class="action-zone">
          <button 
            class="btn-ajouter js-add-to-cart" 
            data-id="chapelet-livia" 
            data-nom="Chapelet Livia"
            data-prix="20"
          >
            <i class="fas fa-shopping-basket"></i> Ajouter au panier
          </button>
        </div>
      </div>
    </div>
  </div>
</MainLayout>

<!-- Script pour changer la grande photo + gestion panier et toaster -->
<script is:inline>
  function changeImage(element) {
    const mainPhoto = document.getElementById('main-photo');
    if (mainPhoto) mainPhoto.src = element.src;
    
    document.querySelectorAll('.miniature').forEach(img => img.classList.remove('active'));
    element.classList.add('active');
  }

  document.addEventListener('astro:page-load', () => {
    const buttons = document.querySelectorAll('.js-add-to-cart');
    const toastContainer = document.getElementById('toast-container');

    const showToast = (nom) => {
      if (!toastContainer) return;
      toastContainer.innerHTML = '';

      const toast = document.createElement('div');
      toast.className = 'confirmation-bar-fixed';
      toast.innerHTML = `
        <div class="conf-inner">
          <div class="conf-text">
            <i class="fas fa-check-circle"></i>
            <span><strong>${nom}</strong> ajouté au panier</span>
          </div>
          <a href="/devis/" class="conf-btn">VOIR MON PANIER</a>
        </div>
      `;
      
      toastContainer.appendChild(toast);

      setTimeout(() => {
        toast.style.transform = 'translateY(-100%)';
        toast.style.opacity = '0';
        setTimeout(() => toast.remove(), 600);
      }, 4000);
    };

    buttons.forEach(btn => {
      btn.onclick = (e) => {
        e.preventDefault();
        const item = {
          id: btn.dataset.id, 
          nom: btn.dataset.nom, 
          prix: btn.dataset.prix
        };

        let panier = JSON.parse(localStorage.getItem('panier-gisele') || '[]');
        panier.push(item);
        localStorage.setItem('panier-gisele', JSON.stringify(panier));

        window.dispatchEvent(new Event('panierMisAJour'));
        showToast(item.nom);
      };
    });
  });
</script>

<style is:global>
  .page-produit-single {
    padding-top: 40px;
    padding-bottom: 80px;
  }

  .btn-retour {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #7b4b94;
    text-decoration: none;
    font-weight: bold;
    margin-bottom: 30px;
    transition: transform 0.2s ease;
  }

  .btn-retour:hover {
    transform: translateX(-5px);
  }

  .produit-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 50px;
    align-items: start;
  }

  /* Galerie de photos */
  .galerie-photos {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .photo-principale {
    width: 100%;
    max-width: 450px;
  }

  .photo-principale img {
    width: 100%;
    height: 500px;
    object-fit: cover;
    background-color: #faf8fc;
    border-radius: 15px;
    box-shadow: 0 10px 30px rgba(123, 75, 148, 0.12);
    display: block;
    margin: 0 auto;
  }

  /* Ajustement de la grille de miniatures responsive */
  .miniatures-grid {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 15px;
    width: 100%;
    max-width: 450px;
  }

  .miniature {
    width: 65px;
    height: 65px;
    object-fit: cover;
    border-radius: 8px;
    cursor: pointer;
    opacity: 0.6;
    border: 2px solid transparent;
    transition: all 0.3s ease;
    flex-shrink: 0;
  }

  .miniature:hover, .miniature.active {
    opacity: 1;
    border-color: #7b4b94;
    transform: translateY(-2px);
  }

  /* Détails et encadré perles */
  .prix-single {
    font-size: 2.2rem;
    font-weight: bold;
    color: #7b4b94;
    margin: 15px 0;
  }

  .description-chapeau {
    font-size: 1.1rem;
    line-height: 1.6;
    color: #555;
    margin-bottom: 25px;
  }

  .caracteristiques-box {
    background: #faf8fc;
    border: 1px solid rgba(179, 157, 219, 0.3);
    padding: 20px;
    border-radius: 12px;
    margin-bottom: 30px;
    text-align: left;
  }

  .caracteristiques-box h3 {
    font-size: 1.1rem;
    color: #5e35b1;
    margin-top: 0;
    margin-bottom: 12px;
  }

  .caracteristiques-box ul {
    padding-left: 20px;
    margin: 0;
    color: #4a3b52;
  }

  .caracteristiques-box li {
    margin-bottom: 8px;
    font-size: 0.95rem;
  }

  .action-zone {
    margin-bottom: 30px;
  }

  /* --- Styles du Toaster --- */
  .global-toast-container {
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    width: 100% !important;
    z-index: 999999 !important;
    pointer-events: none;
  }

  .confirmation-bar-fixed {
    pointer-events: auto;
    background: #7b4b94 !important;
    color: white !important;
    width: 100% !important;
    padding: 15px 0 !important;
    box-shadow: 0 4px 20px rgba(0,0,0,0.3) !important;
    transition: all 0.5s ease-in-out;
    display: block !important;
    border-bottom: 2px solid #D4AF37 !important;
  }

  .conf-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .conf-text {
    display: flex;
    align-items: center;
    gap: 15px;
    font-size: 1.1rem !important;
    font-family: serif;
  }

  .conf-text i {
    color: #D4AF37 !important;
    font-size: 1.5rem;
  }

  .conf-btn {
    background: transparent !important;
    color: white !important;
    border: 1px solid white !important;
    padding: 8px 18px !important;
    border-radius: 4px !important;
    text-decoration: none !important;
    font-weight: bold !important;
    font-size: 0.85rem !important;
    transition: 0.3s !important;
  }

  .conf-btn:hover {
    background: white !important;
    color: #5e35b1 !important;
  }

  @media (max-width: 768px) {
    .produit-grid {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .conf-inner {
      flex-direction: column;
      gap: 10px;
    }

    .miniatures-grid {
      gap: 8px;
    }

    .miniature {
      width: 55px;
      height: 55px;
    }
  }
</style>