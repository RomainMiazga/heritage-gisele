---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Ma Sélection - L'Héritage de Gisèle">
  <section class="container devis-page">
    <h1 class="page-title">Ma Sélection</h1>
    <p class="subtitle">Récapitulatif de vos coups de cœur avant votre demande de devis.</p>

    <div class="devis-container">
      <div class="selection-list">
        <div id="empty-cart-msg" class="hidden">
          <p>Votre sélection est vide pour le moment.</p>
          <a href="/catalogue/" class="btn-retour">Retourner au catalogue</a>
        </div>
        
        <ul id="cart-items"></ul>

        <div id="cart-total" class="total-box hidden">
          <span>Total estimé :</span>
          <span id="total-price">0</span> €
          <p style="font-size: 0.7em; font-weight: normal; color: #666; margin-top: 5px;">
            (Hors frais de port et créations "Sur devis")
          </p>
        </div>
      </div>

      <div class="contact-form-box">
        <h3>Envoyer ma demande</h3>
        <form id="devis-form">
          <div class="input-group">
            <label for="name">Nom & Prénom</label>
            <input type="text" id="name" name="name" required placeholder="Gisèle Martin" />
          </div>

          <div class="input-group">
            <label for="email">Votre Email</label>
            <input type="email" id="email" name="email" required placeholder="nom@exemple.com" />
          </div>

          <div class="input-group">
            <label for="telephone">Votre Téléphone</label>
            <input type="tel" id="telephone" name="telephone" required placeholder="06 12 34 56 78" />
          </div>

          <input type="hidden" id="hidden-selection" name="selection_details" />

          <div class="input-group">
            <label for="message">Votre message (optionnel)</label>
            <textarea id="message" name="message" rows="4" placeholder="Précisez ici vos souhaits particuliers..."></textarea>
          </div>

          <button type="submit" class="btn-submit">
            <i class="fas fa-paper-plane"></i> Envoyer ma demande
          </button>
        </form>
      </div>
    </div>
  </section>
</MainLayout>

<script is:inline>
  // Utilisation de astro:page-load pour les View Transitions
  document.addEventListener('astro:page-load', () => {
    const cartList = document.getElementById('cart-items');
    const emptyMsg = document.getElementById('empty-cart-msg');
    const totalBox = document.getElementById('cart-total');
    const totalPriceEl = document.getElementById('total-price');
    const hiddenInput = document.getElementById('hidden-selection');
    const form = document.getElementById('devis-form');

    function renderSelection() {
      // Protection contre l'erreur classList : on vérifie si les éléments existent
      if (!cartList || !emptyMsg || !totalBox) return;

      const selection = JSON.parse(localStorage.getItem('panier-gisele') || '[]');
      
      if (selection.length === 0) {
        emptyMsg.classList.remove('hidden');
        totalBox.classList.add('hidden');
        cartList.innerHTML = '';
        return;
      }

      emptyMsg.classList.add('hidden');
      totalBox.classList.remove('hidden');
      
      let total = 0;
      let detailsText = "";

      cartList.innerHTML = selection.map((item, index) => {
        let prixValue = parseFloat(item.prix);
        let prixAffiche = item.prix; 
        
        if (!isNaN(prixValue)) {
          total += prixValue;
          prixAffiche = `${item.prix} €`;
        }

        detailsText += `- ${item.nom} (${prixAffiche})\n`;
        
        return `
          <li class="cart-item">
            <div class="cart-item-header">
              <div class="item-info">
                <strong>${item.nom}</strong>
                <span>${prixAffiche}</span>
              </div>
              <button type="button" class="btn-remove" data-index="${index}"><i class="fas fa-trash"></i></button>
            </div>
          </li>
        `;
      }).join('');

      if (totalPriceEl) totalPriceEl.innerText = total;
      if (hiddenInput) hiddenInput.value = detailsText;

      // Gestion des boutons supprimer
      document.querySelectorAll('.btn-remove').forEach(btn => {
        btn.onclick = (e) => {
          const idx = e.currentTarget.dataset.index;
          selection.splice(idx, 1);
          localStorage.setItem('panier-gisele', JSON.stringify(selection));
          window.dispatchEvent(new Event('panierMisAJour'));
          renderSelection();
        };
      });
    }

    // Lancer l'affichage
    renderSelection();

    // Gestion du formulaire
    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = form.querySelector('.btn-submit');
        const originalText = btn.innerHTML;
        const formData = new FormData(form);

        try {
          btn.innerHTML = 'Envoi en cours...';
          btn.disabled = true;

          // Correction URL relative pour éviter la 404
          const response = await fetch('/api/send-email/', {
            method: 'POST',
            body: formData
          });

          if (response.ok) {
            localStorage.removeItem('panier-gisele');
            window.dispatchEvent(new Event('panierMisAJour'));
            window.location.href = "/merci/"; 
          } else {
            const errData = await response.json();
            console.error("Détails erreur:", errData);
            alert("Erreur lors de l'envoi. Vérifiez la console.");
            btn.innerHTML = originalText;
            btn.disabled = false;
          }
        } catch (err) {
          alert("Erreur de connexion.");
          btn.innerHTML = originalText;
          btn.disabled = false;
        }
      });
    }
  });
</script>

<style>
  /* Tes styles restent identiques */
  .hidden { display: none !important; }
  .devis-page { padding: 5px 20px; }
  .page-title { font-size: 3em; color: #7b4b94; text-align: center; }
  .subtitle { text-align: center; margin-bottom: 50px; font-style: italic; }
  .devis-container { display: grid; grid-template-columns: 1fr 1fr; gap: 50px; align-items: start; }
  @media (max-width: 768px) { .devis-container { grid-template-columns: 1fr; } }
  .selection-list { background: white; padding: 30px; border-radius: 15px; box-shadow: 0 5px 15px rgba(0,0,0,0.05); }
  .cart-item { padding: 15px 0; border-bottom: 1px solid #eee; transition: 0.3s; }
  .cart-item:hover { transform: translateX(5px); }
  .cart-item-header { display: flex; justify-content: space-between; align-items: center; }
  .btn-remove { background: none; border: none; color: #ff5252; cursor: pointer; }
  .total-box { margin-top: 20px; text-align: right; font-size: 1.3em; font-weight: bold; color: #7b4b94; }
  .contact-form-box { background: #fbf9fc; padding: 30px; border-radius: 15px; border: 1px solid #7b4b94; }
  .input-group { margin-bottom: 20px; }
  .input-group label { display: block; margin-bottom: 8px; font-weight: bold; }
  .input-group input, .input-group textarea { width: 100%; padding: 12px; border: 1px solid #ddd; border-radius: 8px; }
  .btn-submit { width: 100%; background: #7b4b94; color: white; border: none; padding: 15px; border-radius: 30px; font-weight: bold; cursor: pointer; }
</style>